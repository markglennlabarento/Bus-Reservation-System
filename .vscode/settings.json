{
  "files.associations": {
    "*.h": "cpp",
    "*.hpp": "cpp"
  },
  "editor.formatOnSave": true,
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/src"
  ],
  "C_Cpp.default.compilerPath": "g++",
  "terminal.integrated.env.windows": {
    "PATH": "${env:PATH}"
  }
}
